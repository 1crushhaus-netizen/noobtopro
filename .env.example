# ---------------------------------------------------------------------------
# noobtopro environment variables
#
# Local dev:  cp .env.example .env.local   then fill in your values.
#   .env.local is gitignored and must NEVER be committed.
# On Vercel:  set these in Project -> Settings -> Environment Variables
#   (scope them to Production, Preview, and Development).
# ---------------------------------------------------------------------------

# --- Groq: required for the LLM features (question generation + grading) -----
# Server-side ONLY. Never rename this to NEXT_PUBLIC_* — that would ship the
# key to the browser. Get a key at https://console.groq.com/keys
GROQ_API_KEY=

# Optional model overrides (sensible defaults are used when unset):
#   text model for generation + Learn  (default: llama-3.3-70b-versatile)
# GROQ_MODEL=llama-3.3-70b-versatile
#   grading model — the hottest path (default: openai/gpt-oss-120b, ~3.9x cheaper
#   input than the 70B). Set to llama-3.3-70b-versatile to roll grading back.
# GROQ_GRADE_MODEL=openai/gpt-oss-120b
#   vision model for photo-of-work grading
#   (default: meta-llama/llama-4-scout-17b-16e-instruct)
# GROQ_VISION_MODEL=meta-llama/llama-4-scout-17b-16e-instruct

# --- Supabase: optional (enables Google sign-in + durable, cross-device data)-
# Without these, the app runs in guest mode (browser localStorage).
# Both values are safe in the browser: Row-Level Security scopes every row to
# its owner. Copy them from Supabase -> Settings -> API.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Supabase service role: optional, enables the shared caches (concept guides
#     + diagnostic pool) -------------------------------------------------------
# Server-side ONLY and SECRET (no NEXT_PUBLIC_ prefix). With this set, /api/learn
# stores each generated concept guide in a shared table and reuses it across all
# accounts, AND /api/generate serves the baseline diagnostic from a shared pool
# (and self-fills it) instead of calling Groq every time — so Groq doesn't
# regenerate. Without it, both features still work but regenerate each time.
# Value: Supabase -> Settings -> API -> service_role (secret). In Vercel, add it
# and mark it Sensitive.
SUPABASE_SERVICE_ROLE_KEY=

# --- Question/score token signing secret: optional but RECOMMENDED in prod -----
# Server-side ONLY and SECRET (no NEXT_PUBLIC_ prefix). This is the HMAC key that
# signs the stateless question/step tokens (lib/questionToken.js) binding "a
# question the server generated" to "an answer the server scores" — it's what
# stops a signed-in user from self-authoring questions to inflate their rating.
# If UNSET, it FALLS BACK to SUPABASE_SERVICE_ROLE_KEY above (so token signing
# still works without a separate var). Two consequences of relying on the
# fallback: (1) rotating the service-role key silently invalidates every
# outstanding question token, and (2) if NEITHER is set the secret is empty and
# practice scoring is unavailable. Set this explicitly in production (any long
# random string, e.g. `openssl rand -hex 32`) so token signing is decoupled from
# the service-role key. In Vercel, add it and mark it Sensitive.
# QUESTION_TOKEN_SECRET=

# --- Extra OAuth providers (optional) ----------------------------------------
# Google is always on. GitHub/Discord buttons are hidden until you (1) configure
# the provider in Supabase (see AUTH_PROVIDERS.md) and (2) set the flag below to
# "true" and redeploy. Setting the flag WITHOUT configuring Supabase first will
# show a button that errors on click, so do the Supabase step first.
# NEXT_PUBLIC_ENABLE_GITHUB=true
# NEXT_PUBLIC_ENABLE_DISCORD=true

# --- Admin dashboard allowlist (optional) ------------------------------------
# Server-side ONLY and SECRET (no NEXT_PUBLIC_ prefix). DENY-BY-DEFAULT: if both
# are empty/unset there are NO admins and the Admin tab never appears. The
# /api/admin/* routes verify the caller's Supabase JWT server-side, then check it
# against this allowlist. Set ADMIN_EMAILS to your Google sign-in email(s),
# comma-separated (matched case-insensitively to the verified JWT email). Requires
# SUPABASE_SERVICE_ROLE_KEY + the NEXT_PUBLIC_SUPABASE_* values above. After setting
# in Vercel, redeploy. ADMIN_USER_IDS (Supabase auth UUIDs) is an optional fallback.
# ADMIN_EMAILS=you@example.com
# ADMIN_USER_IDS=

# --- Polar.sh monetization: optional, enables the paid "Pro" product tier -----
# Server-side ONLY and SECRET (no NEXT_PUBLIC_ prefix). DENY-BY-DEFAULT: without these
# (and without SUPABASE_SERVICE_ROLE_KEY above, which the webhook writes through),
# the Pro checkout/webhook are inert and EVERYONE is treated as Free. Build against
# Polar's SANDBOX first (POLAR_SERVER=sandbox), verify the full
# purchase -> webhook -> entitlement loop, THEN flip to production. See MONETIZATION_PLAN.md.
#   POLAR_ACCESS_TOKEN   Organization Access Token (Polar -> Settings). Authenticates API calls.
#   POLAR_WEBHOOK_SECRET Signing secret from the webhook endpoint you create in Polar; the
#                        handler verifies every incoming event against it.
#   POLAR_SERVER         "sandbox" (default while building) or "production".
#   POLAR_PRODUCT_ID_PRO The Pro product's ID (Polar -> Products -> Pro). The server gate
#                        requires an active subscription to be to THIS product before it
#                        grants Pro, so an active sub to any OTHER product in the same org
#                        is not treated as Pro. Comma-separate to allow multiple Pro plans
#                        (e.g. a monthly + an annual product) to map to the same access.
#   POLAR_SUCCESS_URL    Absolute URL Polar redirects to after a successful checkout,
#                        e.g. https://your-domain/?checkout=success (NOT a relative path).
# POLAR_ACCESS_TOKEN=
# POLAR_WEBHOOK_SECRET=
# POLAR_SERVER=sandbox
# POLAR_PRODUCT_ID_PRO=
# POLAR_SUCCESS_URL=
#
# FREE_DAILY_PRACTICE_CAP  Graded practice problems/day for a FREE (non-Pro) account
#                          (default 5). Pro bypasses it. Only enforced when Pro is sellable
#                          (POLAR_ACCESS_TOKEN + POLAR_PRODUCT_ID_PRO set) — so a Polar-less
#                          deployment never caps its free users.
# FREE_DAILY_PRACTICE_CAP=5
#
# NEXT_PUBLIC_PRO_ENABLED  CLIENT flag (browser can't read the server-only POLAR_* secrets):
#                          set "true" to surface the Pro UI (upgrade CTAs, the dashboard
#                          trends/answer-history gate, the €9.99/mo landing card). Flip it on
#                          TOGETHER with the POLAR_* vars above when going live; off by default
#                          so nothing a user sees changes until Pro is actually wired up.
# NEXT_PUBLIC_PRO_ENABLED=true

# --- Transactional email via Resend: optional -------------------------------
# Server-side ONLY and SECRET (no NEXT_PUBLIC_ prefix). DORMANT until BOTH are set:
# lib/email.js sends via Resend's REST API (no SDK) and silently no-ops when unset,
# so the app never blocks on email. Used e.g. for the account-withdrawal acknowledgement.
#   RESEND_API_KEY  Resend API key (https://resend.com -> API Keys). Mark Sensitive in Vercel.
#   EMAIL_FROM      Verified sender, e.g. 'noobtopro <noreply@noobto.pro>'.
# RESEND_API_KEY=
# EMAIL_FROM=noobtopro <noreply@noobto.pro>

# --- Site URL + brand identity (optional) -----------------------------------
# CLIENT/build-time (NEXT_PUBLIC_*, inlined at build → redeploy after changing).
#   NEXT_PUBLIC_SITE_URL  Canonical origin used for absolute URLs in metadata,
#                         robots.txt, sitemaps, and SEO (lib/learn/seo.js, app/layout.js,
#                         app/robots.js). Defaults to https://noobto.pro when unset.
# NEXT_PUBLIC_SITE_URL=https://noobto.pro
#   NEXT_PUBLIC_SAME_AS   Comma-separated authoritative brand profile URLs (Wikidata,
#                         social, Product Hunt, …) emitted as schema.org `sameAs` on the
#                         Organization entity. Omitted entirely when unset.
# NEXT_PUBLIC_SAME_AS=
