# ---------------------------------------------------------------------------
# noobtopro environment variables
#
# Local dev:  cp .env.example .env.local   then fill in your values.
#   .env.local is gitignored and must NEVER be committed.
# On Vercel:  set these in Project -> Settings -> Environment Variables
#   (scope them to Production, Preview, and Development).
# ---------------------------------------------------------------------------

# --- Groq: required for the LLM features (question generation + grading) -----
# Server-side ONLY. Never rename this to NEXT_PUBLIC_* — that would ship the
# key to the browser. Get a key at https://console.groq.com/keys
GROQ_API_KEY=

# Optional model overrides (sensible defaults are used when unset):
#   text model   (default: llama-3.3-70b-versatile)
# GROQ_MODEL=llama-3.3-70b-versatile
#   vision model for photo-of-work grading
#   (default: meta-llama/llama-4-scout-17b-16e-instruct)
# GROQ_VISION_MODEL=meta-llama/llama-4-scout-17b-16e-instruct

# --- Supabase: optional (enables Google sign-in + durable, cross-device data)-
# Without these, the app runs in guest mode (browser localStorage).
# Both values are safe in the browser: Row-Level Security scopes every row to
# its owner. Copy them from Supabase -> Settings -> API.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Extra OAuth providers (optional) ----------------------------------------
# Google is always on. GitHub/Discord buttons are hidden until you (1) configure
# the provider in Supabase (see AUTH_PROVIDERS.md) and (2) set the flag below to
# "true" and redeploy. Setting the flag WITHOUT configuring Supabase first will
# show a button that errors on click, so do the Supabase step first.
# NEXT_PUBLIC_ENABLE_GITHUB=true
# NEXT_PUBLIC_ENABLE_DISCORD=true
